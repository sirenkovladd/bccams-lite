# Copy to .env and fill in. NEVER commit the real file.
# Poll every 5 min (source updates every ~10-15 min).
POLL_INTERVAL_MS=300000
# Rolling retention window (hours). Default: last day.
RETENTION_HOURS=24
# Cloudflare R2 (S3-compatible). Create via Cloudflare dashboard -> R2 -> API tokens.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=bccams-lite
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxxxxxxxxxx.r2.dev
# Optional endpoint override (default: https://<account>.r2.cloudflarestorage.com).
R2_ENDPOINT=
# Local paths (state + append-only JSONL log). Safe to pull while running.
LOG_PATH=./data/archive-log.jsonl
STATE_PATH=./data/archive-state.json
# Camera list (single source of truth, regenerated by scripts/build.mjs).
CAMS_JSON=./data/cams.json
# Parallel fetches per cycle (876 dirs at full city scale).
FETCH_WORKERS=16
# Caps.
MANIFEST_CAP=100
STATS_DEPTH=20
